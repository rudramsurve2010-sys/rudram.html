</section>


<!-- PAGE 3 -->
<section class="page" id="page3">
    <div class="content">
        <h2>Why Are You Special Section Of My Life? 💗</h2>

        <div class="special-box">

            <div class="special-item">
                <strong>Your Smile 😊</strong>
                <p>
                    "It has a way of making everything feel better."
                </p>
            </div>

            <div class="special-item">
                <strong>Your Heart ❤️</strong>
                <p>
                    "You're genuinely one of the sweetest people I've met."
                </p>
            </div>

            <div class="special-item">
                <strong>Our Friendship 🫶</strong>
                <p>
                    "The kind of bond I never want to lose."
                </p>
            </div>

            <div class="special-item">
                <strong>You ✨</strong>
                <p>
                    "Honestly... you don't need a reason. You're just you.
                    And for me you are more then god's gift."
                </p>
            </div>

        </div>

        <button onclick="nextPage()">Next 💕</button>
    </div>
</section>


<!-- PAGE 4 -->
<section class="page" id="page4">
    <div class="content">

        <h2>The Things I Want To Experience With You ❤️</h2>

        <ol class="experience-list">

            <li>
                "First of all I want to stand on marriage stage with you as my bride"
            </li>

            <li>
                "I want sit beside you and talk with you continuously at my house"
            </li>

            <li>
                "I want to go for long drive bike date with you"
            </li>

            <li>
                "I want you to stay by my side whenever no one trust me"
            </li>

            <li>
                "I never want you to leave me for anyone by your own choice except your parents choice"
            </li>

            <li>
                "I want to know that you really love me, and is there anyone in your heart except me"
            </li>

            <li>
                "I want you to feel safe whenever you are with me and if there's any problem you can share with me freely"
            </li>

            <li>
                "Not last point but, I never want you to leave me and be with me forever cuz you are my first and last girl whom I am gonna love and promise me you'll always be mine forever"
            </li>

        </ol>

        <button onclick="nextPage()">Next 💖</button>

    </div>
</section>


<!-- PAGE 5 -->
<section class="page" id="page5">
    <div class="content">

        <div class="note">
            <p class="magic">
                There was a chance for me to give any ability
                then I would give you the ability to see yourself
                by my eyes then you'll get to know how much I love you. ❤️
            </p>
        </div>

        <br>

        <button onclick="nextPage()">Next ✨</button>

    </div>
</section>


<!-- PAGE 6 -->
<section class="page" id="page6">
    <div class="content">

        <div class="cake">🎂✨</div>

        <h1 class="birthday-final">
            Happy Birthday
            <br>
            <span class="glowing-name">Maithili</span> ❤️
        </h1>

        <p>
            Today is all about you. 🌸
        </p>

        <br>

        <button onclick="celebrate()">
            Click To Celebrate 🎉
        </button>

        <br><br>

        <button onclick="nextPage()">
            Continue 💌
        </button>

    </div>
</section>


<!-- PAGE 7 -->
<section class="page" id="page7">
    <div class="content">

        <div class="question">
            Do You Really Love Me? 👀❤️
        </div>

        <button onclick="answerYes()">
            Yes ❤️
        </button>

        <button onclick="answerYes()">
            Ofc Yes 😭❤️
        </button>

        <button onclick="answerNo()">
            No 😶
        </button>

        <div id="answerArea"></div>

    </div>
</section>


<script>

let currentPage = 1;

function showPage(pageNumber) {

    document.querySelectorAll(".page").forEach(page => {
        page.classList.remove("active");
    });

    document.getElementById("page" + pageNumber).classList.add("active");

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
}

function nextPage() {

    if (currentPage < 7) {
        currentPage++;
        showPage(currentPage);
    }
}


/* Floating hearts */
function createHeart() {

    const heart = document.createElement("div");

    heart.className = "heart";

    const hearts = ["❤️", "💗", "💕", "💖", "💓", "✨"];

    heart.innerHTML =
        hearts[Math.floor(Math.random() * hearts.length)];

    heart.style.left = Math.random() * 100 + "vw";

    heart.style.animationDuration =
        (4 + Math.random() * 4) + "s";

    heart.style.fontSize =
        (15 + Math.random() * 20) + "px";

    document.body.appendChild(heart);

    setTimeout(() => {
        heart.remove();
    }, 8000);
}

setInterval(createHeart, 700);


/* Fireworks */
function celebrate() {

    const emojis = [
        "🎆",
        "🎇",
        "✨",
        "💥",
        "🎉",
        "💖"
    ];

    for (let i = 0; i < 35; i++) {

        setTimeout(() => {

            const firework = document.createElement("div");

            firework.className = "firework";

            firework.innerHTML =
                emojis[Math.floor(Math.random() * emojis.length)];

            firework.style.left =
                Math.random() * 95 + "vw";

            firework.style.top =
                Math.random() * 80 + "vh";

            document.body.appendChild(firework);

            setTimeout(() => {
                firework.remove();
            }, 1500);

        }, i * 70);
    }
}


/* Yes answer */
function answerYes() {

    const area = document.getElementById("answerArea");

    area.innerHTML = `
        <div class="answer">🥹❤️</div>
        <div class="thanks">
            Thank youuu Maithili! 💗✨
            <br>
            You just made my birthday website even more special. 🫶
        </div>
    `;

    celebrate();
}


/* No answer */
function answerNo() {

    const area = document.getElementById("answerArea");

    area.innerHTML = `
        <div class="answer">😔💔</div>
        <div class="thanks">
            Oh... 🥺
        </div>
    `;
}

</script>

</body>
</html>